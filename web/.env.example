# Copia este archivo a .env.local y llena las URLs.
# Son las URLs de «Archivo > Compartir > Publicar en la web» (formato CSV) de cada hoja.
# Si se dejan vacías, la app usa la copia local de public/data/ (datos de respaldo, no en vivo).

# Mapa: hoja EntidadesFederativas (regiones por estado)
VITE_ENTIDADES_CSV_URL=

# Mapa: hoja MetricasEntidad (hospitales, servicios, agentes y equipos por estado)
VITE_METRICAS_CSV_URL=

# Dashboard: hoja de avance por día (serie de la gráfica de líneas)
VITE_AVANCE_CSV_URL=

# Dashboard: hoja de métricas Septiembre-Octubre (clave-valor: una métrica por fila)
VITE_SEPOCT_CSV_URL=

# Dashboard: hoja de métricas Noviembre-Diciembre (una fila de resumen)
VITE_NOVDIC_CSV_URL=

# Directorios: hoja de hospitales
VITE_HOSPITALES_CSV_URL=

# Directorios: hoja de contactos médicos
VITE_CONTACTOS_CSV_URL=

# Producción: Amazon Cognito. Las tres son identificadores públicos (no secretos); salen de las "Outputs" de
# infra/template.yaml o del pool que ya exista. Si faltan las tres, no se usa Cognito.
#   VITE_COGNITO_DOMINIO      p. ej. imss-monitor-123456789012.auth.us-east-1.amazoncognito.com
#   VITE_COGNITO_CLIENT_ID    cliente SIN secreto, flujo de código (PKCE), ámbitos openid y email
#   VITE_COGNITO_USER_POOL_ID p. ej. us-east-1_AbCdEf123
VITE_COGNITO_DOMINIO=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_USER_POOL_ID=

# Credencial SOLO de desarrollo para el login local (vite dev); en produccion lo reemplaza Cognito.
VITE_DEV_USUARIO=
VITE_DEV_CLAVE=
